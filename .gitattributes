# Windows batch files MUST stay CRLF in the repo too — GitHub source archives
# serve the stored bytes, and cmd.exe cannot run LF-only batch files.
# -text stores the working-copy bytes as-is (no normalization).
*.bat -text
*.cmd -text

# Text files normalize to LF in the repo (checkout CRLF on Windows by default).
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
